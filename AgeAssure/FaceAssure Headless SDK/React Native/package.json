    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-file-system": "~18.0.12",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
